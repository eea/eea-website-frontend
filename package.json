{
  "name": "eea-website-frontend-dev",
  "description": "EEA Main Website frontend (Plone 6)",
  "license": "MIT",
  "version": "6.6.0",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "start": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto start",
    "start:prod": "pnpm --filter @plone/volto start:prod",
    "analyze": "BUNDLE_ANALYZE=true pnpm build",
    "build": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto build",
    "build:deps": "pnpm --filter @eeacms/countup build && pnpm --filter @plone/registry --filter @plone/components build",
    "lint": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --max-warnings=0 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --fix 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx}'",
    "lint:ci": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --max-warnings=0 -f checkstyle 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx}' > eslint.xml",
    "prettier": "prettier --check 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "prettier:fix": "prettier --write 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "prettier:ci": "prettier --check 'packages/eea-website-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "stylelint": "stylelint 'packages/eea-website-frontend/src/**/*.{css,scss,less}' --allow-empty-input",
    "stylelint:fix": "stylelint 'packages/eea-website-frontend/src/**/*.{css,scss,less}' --fix --allow-empty-input",
    "test": "pnpm --filter eea-website-frontend exec vitest run --passWithNoTests",
    "typecheck": "pnpm --filter eea-website-frontend exec tsc --noEmit",
    "check": "pnpm lint && pnpm prettier && pnpm stylelint && pnpm typecheck && pnpm test",
    "bundlewatch": "bundlewatch --config .bundlewatch.config.json",
    "cypress:run": "pnpm cypress:smoke",
    "cypress:smoke": "NODE_ENV=test CYPRESS_BASE_URL=http://localhost:3000 pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/smoke.cy.js",
    "cypress:staging": "NODE_ENV=test CYPRESS_BASE_URL=https://staging.eea.europa.eu/en pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/acceptance.cy.js",
    "cypress:production": "NODE_ENV=test CYPRESS_BASE_URL=https://www.eea.europa.eu/en pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/acceptance.cy.js",
    "cypress:open": "NODE_ENV=test pnpm exec cypress open --config-file $(pwd)/cypress.config.js",
    "cypress:start-frontend": "RAZZLE_API_PATH=http://localhost:55001/plone pnpm start",
    "i18n": "pnpm --filter eea-website-frontend i18n && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto i18n",
    "develop": "pnpm dlx mrs-developer@2.2.0 missdev --no-config --output=packages --fetch-https",
    "storybook": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto storybook dev -p 6006 -c $(pwd)/.storybook",
    "build-storybook": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto build-storybook -c $(pwd)/.storybook",
    "update": "make update",
    "release": "make release",
    "issues": "make issues",
    "issues:all": "make issues-all",
    "status": "make status",
    "pull": "make pull",
    "volto-update-deps": "volto-update-deps"
  },
  "private": true,
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.overrides",
        "options": {
          "parser": "less"
        }
      }
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-idiomatic-order"
    ],
    "plugins": [
      "stylelint-prettier"
    ],
    "overrides": [
      {
        "files": [
          "**/*.less"
        ],
        "customSyntax": "postcss-less"
      },
      {
        "files": [
          "**/*.overrides"
        ],
        "customSyntax": "postcss-less"
      }
    ],
    "rules": {
      "prettier/prettier": true,
      "rule-empty-line-before": [
        "always-multi-line",
        {
          "except": [
            "first-nested"
          ],
          "ignore": [
            "after-comment"
          ]
        }
      ]
    },
    "ignoreFiles": "theme/themes/default/**/*.overrides"
  },
  "browserslist": [
    ">1%",
    "last 4 versions",
    "Firefox ESR",
    "not ie 11",
    "not dead"
  ],
  "engines": {
    "node": "^24"
  },
